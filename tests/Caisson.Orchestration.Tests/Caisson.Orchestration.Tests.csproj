<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Caisson.Orchestration.Tests</RootNamespace>
    <AssemblyName>Caisson.Orchestration.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Caisson.Domain\Caisson.Domain.csproj" />
    <ProjectReference Include="..\..\src\Caisson.Orchestration\Caisson.Orchestration.csproj" />
    <ProjectReference Include="..\..\src\Caisson.Infrastructure\Caisson.Infrastructure.csproj" />
