<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pure, DB-free unit tests for Caisson.Api (story #308): options validation, actor resolution, the
    in-memory denial overflow accumulator, and the audit-tier classification architecture guard. Postgres-
    backed behaviour lives in Caisson.Api.IntegrationTests/Caisson.Infrastructure.Tests instead.
  -->
  <PropertyGroup>
    <RootNamespace>Caisson.Api.Tests</RootNamespace>
    <AssemblyName>Caisson.Api.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Caisson.Api\Caisson.Api.csproj" />
    <ProjectReference Include="..\..\src\Caisson.Domain\Caisson.Domain.csproj" />
    <ProjectReference Include="..\..\src\Caisson.Infrastructure\Caisson.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

</Project>
