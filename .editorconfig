root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props,targets}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{ts,html,scss}]
indent_size = 2

[*.cs]
# Language conventions
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:suggestion
dotnet_style_readonly_field = true:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

# Naming: private fields _camelCase
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_prefix
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_prefix.capitalization = camel_case
dotnet_naming_style.underscore_prefix.required_prefix = _

# SwitchPort.TaggedVlans is intentionally an array property mapped 1:1 to a PostgreSQL
# integer[] column (observed tagged-VLAN list). Returning an array here is deliberate.
dotnet_diagnostic.CA1819.severity = none

# xUnit1004 etc. left at default; CA rules on via analyzers.

# EF Core migrations are tool-generated (block-namespace + BOM straight from `dotnet ef migrations add`)
# and are not hand-maintained, so exclude them from style/format enforcement rather than reformatting
# generated output on every scaffold. `generated_code = true` makes `dotnet format` and the Roslyn
# analyzers treat the whole Migrations folder as generated (the plain migration .cs files have no
# `<auto-generated />` header, unlike their .Designer.cs siblings, so they need this explicit marker).
[**/Migrations/*.cs]
generated_code = true
