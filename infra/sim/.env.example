# Environment variables for the local simulation-first virtual-rack harness (story #11).
# Copy relevant values into your shell (or an untracked .env you source yourself — this file is
# committed as documentation only and contains no secrets).
#
# See docs/simulation-harness.md for the full walkthrough and docs/adr/0017 for the design rationale.

# --- Postgres (matches infra/sim/docker-compose.yml's postgres service) ---
CAISSON_DB="Host=localhost;Port=5432;Database=caisson;Username=caisson;Password=caisson"
# Optional: point the .NET test suites' DB-backed fixtures (PostgresHarness/PostgresFixture) at the same
# instance instead of falling back to Testcontainers.
CAISSON_TEST_DB="Host=localhost;Port=5432;Database=caisson;Username=caisson;Password=caisson"

# --- Redis (matches infra/sim/docker-compose.yml's redis service; optional — enables live topology
# updates across multiple Caisson.Api instances). Redis now runs with requirepass, so the password is
# part of the connection string. Omit both to run single-instance with no backplane. ---
CAISSON_REDIS="localhost:6379,password=caisson"
CAISSON_TEST_REDIS="localhost:6379,password=caisson"

# --- Optional: override the docker-compose.yml service passwords (both default to 'caisson') by
# exporting these before 'docker compose up'. Both services bind to 127.0.0.1 only. ---
# POSTGRES_PASSWORD="caisson"
# REDIS_PASSWORD="caisson"

# --- Story #11 environment-gated test-auth scheme (ADR 0018) — for local use ONLY.
# NEVER set Testing__EnableTestAuth=true against anything but a local Development/Testing run; the API
# refuses to boot if it's true under any other ASPNETCORE_ENVIRONMENT (TestAuthStartupGuard). ---
ASPNETCORE_ENVIRONMENT="Development"
Testing__EnableTestAuth="false"

# --- Simulator credentials (fixed, non-secret test-only values — never used against real hardware).
# The seeder (tests/Caisson.VirtualRack.Seeder) and the virtual-rack integration harness set these
# themselves; they are listed here only so a contributor driving Caisson.Api by hand against the
# simulators knows what the real driver factories will look for. ---
CAISSON_SWITCH_USERNAME="vrack-seed-switch"
CAISSON_SWITCH_PASSWORD="sim-only-password"
CAISSON_BMC_USERNAME="vrack-seed-bmc"
CAISSON_BMC_PASSWORD="sim-only-password"
# CAISSON_BMC_TLS_FINGERPRINT is generated fresh per run (a new self-signed cert every process start) —
# the seeder/harness compute and set it themselves; there is no fixed value to document here.

# --- Optional: point any of the .NET driver integration suites at REAL hardware instead of the
# in-process simulators (opt-in; unset by default). See RouterOsChrFixture/RedfishBmcFixture. ---
# CAISSON_CHR_HOST="192.0.2.10:8728"
# CAISSON_ILO_HOST="192.0.2.20"
# CAISSON_IPMI_HOST="192.0.2.20"
