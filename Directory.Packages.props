<Project>

  <!-- Central Package Management: all package versions are pinned here. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- EF Core 8 + Npgsql provider (Infrastructure only). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="8.0.8" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.8" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.8" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.8" />
    <PackageVersion Include="Npgsql" Version="8.0.8" />
    <PackageVersion Include="EFCore.NamingConventions" Version="8.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Control-plane API host (story #7, ADR 0012). -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.8" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="6.7.3" />
    <PackageVersion Include="Serilog.AspNetCore" Version="8.0.2" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.NpgSql" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Live topology updates (story #9, ADR 0014): Redis pub/sub + SignalR Redis backplane + health. -->
    <PackageVersion Include="StackExchange.Redis" Version="2.8.16" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="8.0.8" />
    <PackageVersion Include="AspNetCore.HealthChecks.Redis" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test stack. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.8" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Visible dynamic skip ([SkippableFact] + Skip.IfNot) for DB-gated integration tests, so a
         missing Postgres reports as Skipped rather than a false-green Passed. -->
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.23" />
    <PackageVersion Include="FluentAssertions" Version="6.12.1" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="3.10.0" />
    <!-- Live-updates tests (story #9): containerized Redis fan-out + a real .NET SignalR client. -->
    <PackageVersion Include="Testcontainers.Redis" Version="3.10.0" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.8" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <!--
      DI extension points for Caisson.Drivers.Abstractions.Tests only, to exercise the
      registry via a real ServiceCollection. The concrete container is a test-only
      dependency; the abstraction project itself references only the interfaces package
      below.
    -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Interfaces-only DI package for Caisson.Drivers.Abstractions: reflection/codegen-free and
      AOT-friendly (NFR4), unlike the concrete Microsoft.Extensions.DependencyInjection package.
    -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <!--
      Interfaces-only logging package for the concrete drivers (Caisson.Drivers.MikroTik): ILogger +
      NullLogger only, no logging provider/host — AOT-safe like the DI abstractions above (AC6/NFR6).
    -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <!--
      Hosting/options for the discovery orchestration layer (story #8, ADR 0013): BackgroundService for
      the job runner + scheduler, and IOptions binding for the config-bound rack definitions.
    -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Story #11 repo-native seeder (tests/Caisson.VirtualRack.Seeder): a plain console host, unlike
         Caisson.Api's ASP.NET Core host, so it needs the full generic-host builder/console logging. -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Security-review-5 (CI/infra finding): none of these three are direct PackageReferences anywhere —
      each floats in transitively (Caching.Memory/System.Text.Json via the ASP.NET Core/EF Core 8.0.8
      dependency graph; MessagePack via the SignalR client/hub packages above) at a version with a known,
      published high-severity advisory. CentralPackageTransitivePinningEnabled alone only locks whatever
      version resolves; it does not raise it — an explicit PackageVersion entry here is what forces NuGet
      to float the resolved version up to the patched one across every project, with no direct reference
      required. `dotnet list package` with its `vulnerable`/`include-transitive` flags is the way to
      re-check this.
    -->
    <!-- CVE-2024-43483 (GHSA-qj66-m88j-hmgj, DoS) — fixed in the dedicated 8.0.1 patch release. -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
    <!-- CVE-2024-43485 (GHSA-8g4q-xg66-9fp4, DoS) — fixed by 8.0.5; pinned to the latest 8.0.x, 8.0.6. -->
    <PackageVersion Include="System.Text.Json" Version="8.0.6" />
    <!-- GHSA-hv8m-jj95-wg3x/GHSA-vh6j-jc39-fggf (LZ4 decompression memory corruption) plus several
         moderate-severity advisories against 2.5.108 — pinned to the latest 2.5.x release (no need for
         the 3.x major, which changes default resolver/Typeless behaviour) that includes every fix. -->
    <PackageVersion Include="MessagePack" Version="2.5.302" />
  </ItemGroup>

</Project>
