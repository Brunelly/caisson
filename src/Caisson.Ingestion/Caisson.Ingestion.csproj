<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Git-backed desired-state ingestion: fetch, parse, validate, materialise, orchestrate (story #62,
    ADR 0026). The parsing core (Git/Schema/Materializer/Webhook/Security) depends only on
    Caisson.Domain, mirroring Caisson.Correlation's pure layering. The orchestration layer
    (Ingestion/Scheduling/Runner) additionally references Caisson.Infrastructure for CaissonDbContext —
    the same shape Caisson.Orchestration already has for discovery. No Caisson.Drivers.* assembly is
    ever referenced, which is what the M0 driver-boundary guard tests actually check.
  -->
  <PropertyGroup>
    <RootNamespace>Caisson.Ingestion</RootNamespace>
    <AssemblyName>Caisson.Ingestion</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Caisson.Domain\Caisson.Domain.csproj" />
    <ProjectReference Include="..\Caisson.Infrastructure\Caisson.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibGit2Sharp" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Caisson.Ingestion.Tests" />
  </ItemGroup>

</Project>
