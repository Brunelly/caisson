<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MikroTik RouterOS (CHR) read-only discovery driver (story #4). Mirrors the abstractions project's
    layering (ADR 0001/0006): AOT-compatible, no EF Core/Npgsql, and no third-party MikroTik NuGet —
    the RouterOS API client is an internal BCL-only implementation (ADR 0008). References
    Caisson.Domain for MacAddressValue and Caisson.Drivers.Abstractions for the driver contracts.
  -->
  <PropertyGroup>
    <RootNamespace>Caisson.Drivers.MikroTik</RootNamespace>
    <AssemblyName>Caisson.Drivers.MikroTik</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Caisson.Domain\Caisson.Domain.csproj" />
    <ProjectReference Include="..\Caisson.Drivers.Abstractions\Caisson.Drivers.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
