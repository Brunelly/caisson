<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Persistence-ignorant observed-state model. NO EF Core / Npgsql references — see ADR 0001.
  -->
  <PropertyGroup>
    <RootNamespace>Caisson.Domain</RootNamespace>
    <AssemblyName>Caisson.Domain</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the domain tests drive the dense-matrix and memory-linear (Hirschberg) diff paths directly. -->
    <InternalsVisibleTo Include="Caisson.Domain.Tests" />
  </ItemGroup>

</Project>
