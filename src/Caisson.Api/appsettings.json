{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Caisson": ""
  },
  "AzureAd": {
    "Authority": "",
    "Audience": ""
  },
  "Authentication": {
    "RoleMappings": {}
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Git": {
    "GitHub": {
      "Enabled": false,
      "RepoOwner": "",
      "RepoName": "",
      "DefaultBranch": "main",
      "ApiBaseUrl": "https://api.github.com",
      "AuthMode": "Pat",
      "KeyVaultUri": "",
      "PatSecretName": "",
      "BranchPrefix": "caisson",
      "CommitPathTemplate": "desired-state/racks/{slug}.yaml"
    }
  },
  "Testing": {
    "EnableTestAuth": false
  }
}
