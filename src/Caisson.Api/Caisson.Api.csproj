<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The read-only control-plane API host (story #7, ADR 0012). Inherits net8.0 + warnings-as-errors
    from Directory.Build.props. References ONLY Caisson.Infrastructure (Domain/Correlation transitively)
    and — deliberately — NO Caisson.Drivers.* assembly: the query surface is strictly read-only and must
    never reach a device driver (NFR1, enforced by a reflection guard test).
  -->
  <PropertyGroup>
    <RootNamespace>Caisson.Api</RootNamespace>
    <AssemblyName>Caisson.Api</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Caisson.Infrastructure\Caisson.Infrastructure.csproj" />
    <!--
      Discovery orchestration (story #8). The API references only this project; it names NO
      Caisson.Drivers.* type, so the non-transitive Api_references_no_driver_assembly guard stays green
      (driver access is transitive through Caisson.Orchestration at runtime).
    -->
    <ProjectReference Include="..\Caisson.Orchestration\Caisson.Orchestration.csproj" />
    <!--
      Git-backed desired-state ingestion (story #62, ADR 0026). Same shape as the Orchestration
      reference above: no Caisson.Drivers.* assembly is named, so the guard test stays green.
    -->
    <ProjectReference Include="..\Caisson.Ingestion\Caisson.Ingestion.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <!-- Live topology updates (story #9, ADR 0014): SignalR Redis backplane + Redis connectivity health. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Story #308: AuditOutboxDispatcher's internal TickAsync lets its Postgres-backed tests drive a
      dispatch tick deterministically without the PeriodicTimer — those tests live in
      Caisson.Infrastructure.Tests (alongside the claim-SQL/schema tests), not a Caisson.Api test project.
    -->
    <InternalsVisibleTo Include="Caisson.Infrastructure.Tests" />
  </ItemGroup>

</Project>
