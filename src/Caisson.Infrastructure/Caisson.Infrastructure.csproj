<Project Sdk="Microsoft.NET.Sdk">

  <!-- EF Core 8 + Npgsql persistence for the observed-state model. -->
  <PropertyGroup>
    <RootNamespace>Caisson.Infrastructure</RootNamespace>
    <AssemblyName>Caisson.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Caisson.Domain\Caisson.Domain.csproj" />
    <!--
      The persistence bridge maps the pure correlation result + observed input into the domain graph
      (story #7, ADR 0011). No layering rule forbids Infrastructure depending on the pure Correlation
      engine; Correlation stays EF-free.
    -->
    <ProjectReference Include="..\Caisson.Correlation\Caisson.Correlation.csproj" />
    <!--
      The drift persistence bridge (story #64) maps the persisted desired/observed graphs into the pure
      engine's inputs and the pure result back into persisted DriftReport/DriftItem rows. Same shape as
      the Correlation reference above: Caisson.Drift stays EF-free (PurityGuardTests enforces this).
    -->
    <ProjectReference Include="..\Caisson.Drift\Caisson.Drift.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <!--
      Live topology updates (story #9, ADR 0014): the fail-open Redis publisher lives here — Infrastructure
      is the lowest layer both Orchestration and Api reference, so the real-time seam ships without either
      of them naming Redis. SignalR/backplane wiring stays in Caisson.Api.
    -->
    <PackageReference Include="StackExchange.Redis" />
    <!-- Bind RealtimeOptions from the Realtime configuration section (OptionsBuilder.Bind / Get<T>). -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <!-- DriftComputationHealthCheck implements IHealthCheck (story #64) without an ASP.NET Core framework reference. -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" />
  </ItemGroup>

</Project>
