<Project Sdk="Microsoft.NET.Sdk">

  <!-- EF Core 8 + Npgsql persistence for the observed-state model. -->
  <PropertyGroup>
    <RootNamespace>Caisson.Infrastructure</RootNamespace>
    <AssemblyName>Caisson.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Caisson.Domain\Caisson.Domain.csproj" />
    <!--
      The persistence bridge maps the pure correlation result + observed input into the domain graph
      (story #7, ADR 0011). No layering rule forbids Infrastructure depending on the pure Correlation
      engine; Correlation stays EF-free.
    -->
    <ProjectReference Include="..\Caisson.Correlation\Caisson.Correlation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
  </ItemGroup>

</Project>
