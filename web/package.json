{
  "name": "web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:e2e": "ng build --configuration e2e",
    "serve:e2e": "http-server dist/web/browser -p 4200 -a 127.0.0.1 -s --proxy http://127.0.0.1:4200?",
    "build:harness": "ng build --configuration harness",
    "serve:harness": "http-server dist/web/browser -p 4200 -a 127.0.0.1 -s --proxy http://127.0.0.1:4200?",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"e2e/**/*.ts\" \"playwright.config.ts\"",
    "format:write": "prettier --write \"src/**/*.{ts,html,scss}\" \"e2e/**/*.ts\" \"playwright.config.ts\"",
    "e2e": "playwright test"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/cdk": "^22.0.6",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@microsoft/signalr": "^10.0.0",
    "angular-auth-oidc-client": "^21.0.2",
    "d3": "^7.9.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.0",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/d3": "^7.4.3",
    "angular-eslint": "22.1.0",
    "axe-core": "^4.12.1",
    "eslint": "^10.6.0",
    "http-server": "14.1.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8"
  }
}
